		"/calc_embeddings": {
			"post": {
				"summary": "Calc Embeddings",
				"description": "Extract features from images which have been uploaded or there location are specified by the image directory. If bounding boxes are specified (annotation_data) for the images, then the features are extracted only for the regions defined by the bounding boxes, otherwise the features are extracted for the whole image. if calc_average_embedding is True, then the average embedding for the image or for each bounding box is calculated.",
				"operationId": "calc_embeddings_calc_embeddings_post",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CalcEmbeddingsPostRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "Calculation of embeddings started successfully",
						"content": {
							"application/json": {
								"schema": {},
								"example": {
									"jobid": "123",
									"status": "ongoing"
								}
							}
						}
					},
					"429": {
						"description": "Too many requests waiting",
						"content": {
							"application/json": {
								"example": {
									"code": 429,
									"description": "Too many requests waiting"
								}
							}
						}
					},
					"400": {
						"description": "Bad request",
						"content": {
							"application/json": {
								"example": {
									"code": 400,
									"description": "No bounding boxes specified"
								}
							}
						}
					},
					"422": {
						"description": "Validation Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						}
					}
				}
			}
		},
