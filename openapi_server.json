{
	"openapi": "3.1.0",
	"info": {
		"title": "Object Detector API",
		"description": "This API provides endpoints for object detection tasks including model training, inference, and prototype management.",
		"version": "0.1.0"
	},
	"servers": [
		{
			"url": "http://localhost:8001",
			"description": "local instance"
		}
	],
	"paths": {
		"/job_status/{jobId}": {
			"get": {
				"summary": "Job Status",
				"operationId": "job_status_job_status__jobId__get",
				"parameters": [
					{
						"name": "jobId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string",
							"title": "Jobid"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Job status and result",
						"content": {
							"application/json": {
								"schema": {},
								"example": {
									"status": "completed",
									"result": [
										{
											"image_file": "v_27570344_3_1854.jpg",
											"feature": [
												{
													"region": [
														235,
														379,
														2308,
														3028
													],
													"class": "hot balloon",
													"confidence": 0.9710983633995056
												}
											]
										}
									]
								}
							}
						}
					},
					"404": {
						"description": "Job not found",
						"content": {
							"application/json": {
								"example": {
									"code": 404,
									"description": "Job not found"
								}
							}
						}
					},
					"500": {
						"description": "Internal server error",
						"content": {
							"application/json": {
								"example": {
									"code": 500,
									"description": "Error message"
								}
							}
						}
					},
					"422": {
						"description": "Validation Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						}
					}
				}
			}
		},
		"/status": {
			"get": {
				"summary": "Status",
				"operationId": "status_status_get",
