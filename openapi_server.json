								"schema": {
									"$ref": "#/components/schemas/StatusService"
								}
							}
						}
					}
				}
			}
		},
		"/reset_model": {
			"post": {
				"summary": "Reset Model",
				"description": "Deletes all new trained object classes for the dataset. After that only the pretrained object classes can be detected",
				"operationId": "reset_model_reset_model_post",
				"parameters": [
					{
						"name": "model_id",
						"in": "query",
						"required": false,
						"schema": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							],
							"title": "Model Id"
						}
					},
					{
						"name": "reset_finetuning",
						"in": "query",
						"required": false,
						"schema": {
							"anyOf": [
								{
									"type": "boolean"
								},
								{
									"type": "null"
								}
							],
							"default": false,
							"title": "Reset Finetuning"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Start model reset successfully",
						"content": {
							"application/json": {
								"schema": {},
								"example": {
									"jobid": "123",
									"status": "ongoing"
								}
							}
						}
					},
					"429": {
						"description": "Too many requests waiting",
						"content": {
							"application/json": {
								"example": {
									"code": 429,
									"description": "Too many requests waiting"
								}
							}
						}
					},
					"422": {
						"description": "Validation Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						}
					}
				}
			}
		},
