		"/image_region_proposals": {
			"post": {
				"summary": "Image Region Proposals",
				"description": "Get the region proposals for an image (first step in the object detection process. These regions are not the same regions which are detected for specific object classes!",
				"operationId": "image_region_proposals_image_region_proposals_post",
