		"/set_model": {
			"post": {
				"summary": "Set Model",
				"description": "Sets the model (prototype dataset) of the object detector. If it is already available then it will be reloaded otherwise a new model will be created. The attributes for a new model can be specified in the setting dictionary ('pretrained_dataset': 'coco' or 'lvis', 'weighted_patch_calculation': True or False)",
				"operationId": "set_model_set_model_post",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SetModelRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "Prototype dataset is set",
						"content": {
							"application/json": {
								"schema": {},
								"example": {
									"status": "completed"
								}
							}
						}
					},
					"500": {
						"description": "Internal server error",
						"content": {
							"application/json": {
								"example": {
									"code": 500,
									"description": "Error message"
								}
							}
						}
					},
					"422": {
