		"/inc_training": {
			"post": {
				"summary": "Inc Training",
				"description": "Incrementally training of additional objects by using uploaded images. The annotation information for the objects is provided with the images by binary mask images or by a  JSON file (with the filename dataset_dicts.json in each training image directory). By the parameter training_mode it can be specified if a new object class ('new_object') or an additional view of the object ('multi_view') should be trained. If a new object class should be trained, then a previous trained object class with the same name will be replaced.",
				"operationId": "inc_training_inc_training_post",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/IncTrainingPostRequest"
							}
						}
